{
  "name": "Ash Ketchum",
  "description": "Telegram rename + convert bot with Firebase thumbnail persistence.",
  "logo": "https://telegra.ph/file/dc50604bc29b93d90336d.jpg",
  "keywords": ["telegram", "rename", "pyrogram", "firebase"],
  "repository": "https://github.com/Judson-web/Ash-Ketchum",
  "env": {
    "TG_BOT_TOKEN": {"description": "Bot token from @BotFather"},
    "APP_ID": {"description": "Telegram API ID"},
    "API_HASH": {"description": "Telegram API HASH"},
    "UPDATE_CHANNEL": {"description": "Channel username without @", "required": false},
    "OWNER_ID": {"description": "Owner user id", "required": false},
    "AUTH_USERS": {"description": "Space separated allowed user ids", "required": false},
    "BANNED_USERS": {"description": "Space separated banned user ids", "required": false},
    "FIREBASE_PROJECT_ID": {"description": "Firebase project id", "required": false},
    "FIREBASE_CREDENTIALS_JSON": {"description": "Service account JSON string", "required": false},
    "FIREBASE_CREDENTIALS_PATH": {"description": "Path to service account json in dyno", "required": false}
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    {"url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest"},
    {"url": "heroku/python"}
  ]
}
